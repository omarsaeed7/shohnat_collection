meta {
  name: verifyOtp
  type: http
  seq: 2
}

post {
  url: {{driver_url}}/auth/verify-otp
  body: json
  auth: inherit
}

body:json {
  {
    "phone": "1023572561",
    "phone_code": "+20",
    "otp": "123456"
  }
}

vars:post-response {
  driver_token: res.body.data.token
}

settings {
  encodeUrl: true
  timeout: 0
}
