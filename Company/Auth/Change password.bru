meta {
  name: Change password
  type: http
  seq: 7
}

post {
  url: {{company_url}}/auth/change-password
  body: multipartForm
  auth: bearer
}

headers {
  X-Api-Key: 123456
}

auth:bearer {
  token: {{company_token}}
}

body:multipart-form {
  current_password: 12345678
  password: 12345678
  password_confirmation: 12345678
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
