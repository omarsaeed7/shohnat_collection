meta {
  name: send-phone-verification
  type: http
  seq: 8
}

post {
  url: {{company_url}}/auth/send-phone-verification
  body: multipartForm
  auth: bearer
}

headers {
  X-Api-Key: 123456
}

auth:bearer {
  token: {{company_token}}
}

body:multipart-form {
  phone: 1124782714
  phone_code: +20
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}
