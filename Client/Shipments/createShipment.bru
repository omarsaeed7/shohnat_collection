meta {
  name: createShipment
  type: http
  seq: 1
}

post {
  url: {{client_url}}/shipments
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  vehicle_type_id: 1
  pickup_national_address_name: test
  pickup_latitude: 30.33
  pickup_longitude: 31.322
  delivery_national_address_name: test2
  delivery_latitude: 30.23
  delivery_longitude: 32.23
  type: building tools
  weight: 27
  recipient_phone: 0554213123
  is_scheduled: 1
  pickup_date: 2026-12-12
  pickup_time: 10:30
  addition_details: test
  coupon: 
  images[0]: @file(/home/momenanoh/Pictures/Screenshots/Screenshot from 2026-04-19 14-11-50.png)
  images[1]: @file(/home/momenanoh/Pictures/Screenshots/Screenshot from 2026-04-20 15-22-39.png)
  images[2]: @file(/home/momenanoh/Pictures/Screenshots/Screenshot from 2026-04-20 15-22-39.png)
  images[3]: @file(/home/momenanoh/Pictures/Screenshots/Screenshot from 2026-04-20 15-17-02.png)
  ~pickup_address_id: 1
  ~delivery_address_id: 1
  ~sender_phone: 0553123123
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  'vehicle_type_id' => ['required', 'integer', 'exists:vehicle_types,id'], // نوع المركبة
  'pickup_address_id' => ['nullable', 'integer', 'exists:client_addresses,id'], // عنوان من العناوين المحفوظة
  'pickup_national_address_name' => ['required_without:pickup_address_id', 'string'], // العنوان الوطني
  'pickup_latitude' => ['required_without:pickup_address_id', 'string'],
  'pickup_longitude' => ['required_without:pickup_address_id', 'string'],
  'delivery_address_id' => ['nullable', 'integer', 'exists:client_addresses,id'], // عنوان من العناوين المحفوظة
  'delivery_national_address_name' => ['required_without:delivery_address_id', 'string'], // العنوان الوطني
  'delivery_latitude' => ['required_without:delivery_address_id', 'string'],
  'delivery_longitude' => ['required_without:delivery_address_id', 'string'],
  'type' => ['required', 'string', 'max:255'],
  'weight' => ['required', 'numeric', 'min:0'],
  'sender_phone' => ['nullable', 'string', 'regex:/^(05|5)[0-9]{8}$/'],
  'recipient_phone' => ['required', 'string', 'regex:/^(05|5)[0-9]{8}$/'],
  'addition_details' => ['nullable', 'string'],
  'is_scheduled' => ['boolean'],
  'pickup_date' => ['nullable', 'required_if:is_scheduled,true', 'date', 'after_or_equal:today'],
  'pickup_time' => ['nullable', 'required_if:is_scheduled,true', 'string'],
  'coupon' => [
      'nullable',
      'string',
      'max:255',],
  'images' => ['nullable', 'array', 'max:4'],
  'images.*' => ['image', 'mimes:jpeg,png,jpg,webp', 'max:5120'],
}
