  discount_type: 
  total_price: 20
  images[0]: @file(/home/nami/Pictures/tesla-logo-2007-black-download.png)
  images[1]: @file(/home/nami/Pictures/tesla-logo-2007-full-download.png)
  images[2]: @file(/home/nami/Pictures/toyota-logo-2020-europe-download.png)
