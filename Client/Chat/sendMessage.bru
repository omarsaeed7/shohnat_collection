meta {
  name: sendMessage
  type: http
  seq: 2
}

post {
  url: {{client_url}}/:shipmentId/send/:driverId
  body: multipartForm
  auth: inherit
}

params:path {
  driverId: 1
  shipmentId: 1
}

body:multipart-form {
  message_type: negotiation
  message: 23
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  - message : String | number
  - message_type : normal | negotiation 
}
