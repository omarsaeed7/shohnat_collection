meta {
  name: verifyOtp
  type: http
  seq: 2
}

post {
  url: {{client_url}}/auth/verify-otp
  body: json
  auth: inherit
}

body:json {
  {
    "phone": "01023572563",
    "phone_code": "+20",
    "type": "user",
    "otp": "123456"
  }
}

vars:post-response {
  client_token: res.body.body.token
}

settings {
  encodeUrl: true
  timeout: 0
}
