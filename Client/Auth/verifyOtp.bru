meta {
  name: verifyOtp
  type: http
  seq: 2
}

post {
  url: {{client_url}}/auth/verify-otp
  body: json
  auth: inherit
}

body:json {
  {
    "phone": "544444444",
    "phone_code": "+966",
    "otp": "123456"
  }
}

vars:post-response {
  client_token: res.body.data.token
}

settings {
  encodeUrl: true
  timeout: 0
}
