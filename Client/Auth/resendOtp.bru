meta {
  name: resendOtp
  type: http
  seq: 5
}

post {
  url: {{client_url}}/auth/resend-otp
  body: json
  auth: inherit
}

body:json {
  {
    "phone": "1023572562",
    "phone_code": "+20",
    "profile_type": "client",
    "channel": "whatsapp"
  }
}

vars:post-response {
  client_otp: res.body.data.access_token
}

settings {
  encodeUrl: true
  timeout: 0
}
